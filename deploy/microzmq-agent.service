[Unit]
Description=micro-ZMQ agent (ESP32 TCP -> ZeroMQ)
After=network.target microzmq-broker.service
Wants=microzmq-broker.service

[Service]
User=microzmq
EnvironmentFile=/etc/microzmq.env
ExecStart=/usr/local/bin/microzmq_agent --listen 0.0.0.0 --port 7400
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
